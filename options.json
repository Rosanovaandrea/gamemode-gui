{
  "version": 1,
  "categories": [
    {
      "id": "general",
      "tab_id": "tab.general",
      "title_id": "step.general.title",
      "subtitle_id": "step.general.subtitle",
      "options": [
        {
          "key": "reaper_freq",
          "description_id": "opt.general.reaper_freq",
          "value_type": "int",
          "widget": "stepper",
          "range": [1, null],
          "default": 5,
          "special": false,
          "comment": "; The reaper thread will check every 5 seconds for exited clients, for config file changes, and for the CPU/iGPU power balance"
        },
        {
          "key": "desiredgov",
          "description_id": "opt.general.desiredgov",
          "value_type": "choice",
          "widget": "radio",
          "default": "performance",
          "special": true,
          "special_source": "cpu_governors",
          "comment": "; The desired governor is used when entering GameMode instead of \"performance\""
        },
        {
          "key": "defaultgov",
          "description_id": "opt.general.defaultgov",
          "value_type": "choice",
          "widget": "radio",
          "default": "",
          "special": true,
          "special_source": "cpu_governors",
          "comment": "; The default governor is used when leaving GameMode instead of restoring the original value"
        },
        {
          "key": "desiredprof",
          "description_id": "opt.general.desiredprof",
          "value_type": "choice",
          "widget": "radio",
          "choices": ["performance", "low-power", "balanced"],
          "default": "performance",
          "special": false,
          "comment": "; The desired platform profile is used when entering GameMode instead of \"performance\""
        },
        {
          "key": "defaultprof",
          "description_id": "opt.general.defaultprof",
          "value_type": "choice",
          "widget": "radio",
          "choices": ["performance", "low-power", "balanced"],
          "default": "",
          "special": false,
          "comment": "; The default platform profile is used when leaving GameMode instead of restoring the original value"
        },
        {
          "key": "igpu_desiredgov",
          "description_id": "opt.general.igpu_desiredgov",
          "value_type": "choice",
          "widget": "radio",
          "default": "powersave",
          "special": true,
          "special_source": "cpu_governors",
          "comment": "; The iGPU desired governor is used when the integrated GPU is under heavy load"
        },
        {
          "key": "igpu_power_threshold",
          "description_id": "opt.general.igpu_power_threshold",
          "value_type": "float",
          "widget": "stepper",
          "range": [-1.0, 1.0],
          "default": 0.3,
          "special": false,
          "comment": "; Threshold to use to decide when the integrated GPU is under heavy load"
        },
        {
          "key": "softrealtime",
          "description_id": "opt.general.softrealtime",
          "value_type": "choice",
          "widget": "radio",
          "choices": ["auto", "on", "off"],
          "default": "off",
          "special": false,
          "comment": "; GameMode can change the scheduler policy to SCHED_ISO on kernels which support it"
        },
        {
          "key": "renice",
          "description_id": "opt.general.renice",
          "value_type": "int",
          "widget": "stepper",
          "range": [0, 20],
          "default": 0,
          "special": false,
          "comment": "; GameMode can renice game processes. You can put any value between 0 and 20 here"
        },
        {
          "key": "ioprio",
          "description_id": "opt.general.ioprio",
          "value_type": "choice",
          "widget": "radio",
          "choices": ["0", "1", "2", "3", "4", "5", "6", "7", "off", "reset"],
          "default": "0",
          "special": false,
          "comment": "; By default, GameMode adjusts the iopriority of clients to BE/0"
        },
        {
          "key": "inhibit_screensaver",
          "description_id": "opt.general.inhibit_screensaver",
          "value_type": "bool",
          "widget": "switch",
          "default": true,
          "special": false,
          "comment": "; Sets whether gamemode will inhibit the screensaver when active"
        },
        {
          "key": "disable_splitlock",
          "description_id": "opt.general.disable_splitlock",
          "value_type": "bool",
          "widget": "switch",
          "default": true,
          "special": false,
          "comment": "; Sets whether gamemode will disable split lock mitigation when active"
        }
      ]
    },
    {
      "id": "gpu",
      "tab_id": "tab.gpu",
      "title_id": "step.gpu.title",
      "subtitle_id": "step.gpu.subtitle",
      "banner_id": "gpu.banner",
      "options": [
        {
          "key": "apply_gpu_optimisations",
          "description_id": "opt.gpu.apply_gpu_optimisations",
          "label_id": "opt.gpu.enable_power_plan.label",
          "value_type": "enable",
          "widget": "switch",
          "default": "0",
          "on_value": "accept-responsibility",
          "special": false,
          "comment": "; Warning: Use these settings at your own risk. Any damage to hardware is your responsibility and yours alone"
        },
        {
          "key": "gpu_device",
          "description_id": "opt.gpu.gpu_device",
          "value_type": "int",
          "widget": "stepper",
          "range": [0, null],
          "default": 0,
          "special": false,
          "depends_on": "gpu.apply_gpu_optimisations",
          "comment": "; The DRM device number on the system (usually 0)"
        },
        {
          "key": "nv_powermizer_mode",
          "description_id": "opt.gpu.nv_powermizer_mode",
          "value_type": "choice",
          "widget": "radio",
          "choices": ["0", "1", "2"],
          "default": "",
          "special": false,
          "depends_on": "gpu.apply_gpu_optimisations",
          "comment": "; Nvidia specific settings\n; Requires the coolbits extension activated in nvidia-xconfig"
        },
        {
          "key": "nv_core_clock_mhz_offset",
          "description_id": "opt.gpu.nv_core_clock_mhz_offset",
          "value_type": "int",
          "widget": "stepper",
          "range": [null, null],
          "default": -1,
          "special": false,
          "depends_on": "gpu.apply_gpu_optimisations",
          "comment": ""
        },
        {
          "key": "nv_mem_clock_mhz_offset",
          "description_id": "opt.gpu.nv_mem_clock_mhz_offset",
          "value_type": "int",
          "widget": "stepper",
          "range": [null, null],
          "default": -1,
          "special": false,
          "depends_on": "gpu.apply_gpu_optimisations",
          "comment": ""
        },
        {
          "key": "amd_performance_level",
          "description_id": "opt.gpu.amd_performance_level",
          "value_type": "choice",
          "widget": "radio",
          "choices": ["auto", "low", "high", "manual"],
          "default": "",
          "special": false,
          "depends_on": "gpu.apply_gpu_optimisations",
          "comment": "; AMD specific settings\n; Requires a relatively up to date AMDGPU kernel module"
        }
      ]
    },
    {
      "id": "cpu",
      "tab_id": "tab.cpu",
      "title_id": "step.cpu.title",
      "subtitle_id": "step.cpu.subtitle",
      "options": [
        {
          "key": "pin_cores",
          "description_id": "opt.cpu.pin_cores",
          "value_type": "cores",
          "widget": "cores",
          "special": true,
          "special_source": "cpu_cores",
          "default": [],
          "comment": "; Pin the game to a specific list of cores (comma separated, \"-\" for ranges).\n; Leave empty to let GameMode auto-detect the cores to use."
        },
        {
          "key": "park_cores",
          "description_id": "opt.cpu.park_cores",
          "value_type": "bool",
          "widget": "switch",
          "default": false,
          "comment": "; Park (offline) all cores except the ones used by the game.\n; Requires the user to be in the 'gamemode' group."
        }
      ]
    },
    {
      "id": "custom",
      "tab_id": "tab.custom",
      "title_id": "step.custom.title",
      "subtitle_id": "step.custom.subtitle",
      "toggle_card_id": "custom.notifications.title",
      "options": [
        {
          "key": "notify_start",
          "description_id": "opt.custom.notify_start",
          "label_id": "opt.custom.notify_start.label",
          "value_type": "toggle_entry",
          "widget": "switch",
          "default": false,
          "special": false,
          "target": "custom.start",
          "entry": "notify-send \"GameMode started\""
        },
        {
          "key": "notify_end",
          "description_id": "opt.custom.notify_end",
          "label_id": "opt.custom.notify_end.label",
          "value_type": "toggle_entry",
          "widget": "switch",
          "default": false,
          "special": false,
          "target": "custom.end",
          "entry": "notify-send \"GameMode ended\""
        },
        {
          "key": "start",
          "description_id": "opt.custom.start",
          "value_type": "list",
          "widget": "list",
          "default": [],
          "comment": "; Custom scripts executed (via /bin/sh) when GameMode starts"
        },
        {
          "key": "end",
          "description_id": "opt.custom.end",
          "value_type": "list",
          "widget": "list",
          "default": [],
          "comment": "; Custom scripts executed (via /bin/sh) when GameMode ends"
        },
        {
          "key": "script_timeout",
          "description_id": "opt.custom.script_timeout",
          "value_type": "int",
          "widget": "stepper",
          "range": [0, null],
          "default": 10,
          "comment": "; Timeout for scripts (seconds). Scripts are killed if they do not complete in time."
        }
      ]
    }
  ]
}
